@model Models.RecipeViewModel
@{
    ViewData["Title"] = "Recipe";
}

<div class="container-fluid">

    <div class="row">
        <!-- sidebar: meal types -->
        <div class="col-2 mt-4">
            <div class="shadow rounded">
                <div class="border-bottom border-3 p-2">
                    <h4 class="text-pink text-center">Our Menu</h4>

                    <ul class="list-group list-group-flush position-sticky" id="Menu-list">
                        @foreach (var t in Model.MealTypes)
                        {
                            var active = t.Id == Model.SelectedTypeId ? "active" : "";
                            <li class="list-group-item menu-item @active">
                                <a class="nav-link p-0"
                                   asp-action="RecipeIndex"
                                   asp-route-typeId="@t.Id">
                                    @t.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- cards: meals for the selected type -->
        <div class="col-10 mt-4">
            <div class="row">
                @if (!Model.Meals.Any())
                {
                    <div class="col-12">
                        <p class="text-muted">No items in this category.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in Model.Meals)
                    {
                        <div class="col-md-4">
                            <div class="card mb-3">
                                <img src="@item.ImageUrl"
                                     class="card-img-top"
                                     alt="@item.Name"
                                     title="@item.Name"
                                     style="height:180px; object-fit:cover;" />
                                <div class="card-body">
                                    <h5 class="card-title">@item.Name</h5>
                                    <p class="card-text">@item.Description</p>
                                    <p class="card-text">
                                        <strong>Price:</strong> @item.Price.ToString("C")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
