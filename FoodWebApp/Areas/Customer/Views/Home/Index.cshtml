@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row shadow rounded">
        <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">

            <div id="carouselExampleSlidesOnly" class="carousel slide " data-bs-ride="carousel">
                <div class="carousel-inner h-100">
                    <div class="carousel-item active">
                        <img src="/images/carouselImages/pexels-fotios-photos-1279330.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>

                    <div class="carousel-item">
                        <img src="/images/carouselImages/magic-foods.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>

                    <div class="carousel-item">
                        <img src="/images/carouselImages/pexels-ash-craig-122861-376464.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>
                </div>
            </div>

        </div>

        <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">
            <div class="mb-3">
                <h2><span class="text-success"><strong>Get the Best Food from the Finest Restaurant</strong></span></h2>

            </div>

            <div class="mb-3 p-3">
                <span> <i class="fa-solid fa-leaf text-success mx-2 fs-4"></i> </span>
                <span class="fs-5 text-dark"> Fresh Food</span>
            </div>

            <div class="mb-3 p-3">
                <span> <i class="fa-solid fa-leaf text-success mx-2 fs-4"></i> </span>
                <span class="fs-5 text-dark"> Fast Delivery</span>

            </div>

            <div class="mb-3 p-3">
                <span> <i class="fa-solid fa-leaf text-success mx-2 fs-4"></i> </span>
                <span class="fs-5 text-dark"> Best Quality</span>
            </div>


        </div>


    </div>

    <div class="row mt-5">
        <div class="mb-3">
            <h2 class="text-bg-dark"> Today' Special'</h2>
            <div id="todaySpecial" class="row">
                <div class="col-sm-4 col-md-4 col-xl-4">
                    <div class=" shadow rounded card dishCard">
                        <img class="card-img-top h-75" src="http://forkify-api.herokuapp.com/images/steakhousepizza0b87.jpg" alt="dish" />
                        <div class="card-body">
                            <p class="card-title fw-bolder">Pizza</p>
                        </div>

                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-xl-4">
                    <div class=" shadow rounded card dishCard">
                        <img class="card-img-top h-75" src="http://forkify-api.herokuapp.com/images/Bacon2BDouble2BCheese2BBurger2BSalad2B5002B61668d04f9e9.jpg" />
                        <div class="card-body">
                            <p class="card-title fw-bolder">Burger</p>
                        </div>

                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-xl-4">
                    <div class="shadow rounded card dishCard">
                        <img class="card-img-top h-75" src="http://forkify-api.herokuapp.com/images/4204711663_3b0de36aaecd31.jpg" />
                        <div class="card-body">
                            <p class="card-title fw-bolder">Macaroni</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
