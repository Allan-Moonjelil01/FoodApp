@model Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}
<h2 class="mb-4">Checkout</h2>

<h5 class="mb-3">Billing & Shipping Details</h5>
<form id="checkoutForm" class="mb-5">
    <div class="row g-3">
        <!-- Name -->
        <div class="col-md-6 col-lg-4">
            <label for="firstName" class="form-label">First Name *</label>
            <input type="text" class="form-control" id="firstName" required />
        </div>
        <div class="col-md-6 col-lg-4">
            <label for="lastName" class="form-label">Last Name *</label>
            <input type="text" class="form-control" id="lastName" required />

        </div>
        <!-- Contact -->
        <div class="col-md-6 col-lg-4">
            <label for="email" class="form-label">Email *</label>
            <input type="email" class="form-control" id="email" required />
        </div>
        <div class="col-md-6 col-lg-4">
            <label for="phone" class="form-label">Phone *</label>
            <input type="tel" class="form-control" id="phone" required />
        </div>

        <!-- Address -->
        <div class="col-md-6 col-lg-4">
            <label for="address" class="form-label">Street Address *</label>
            <input type="text" class="form-control" id="address" required />
        </div>
        <div class="col-md-6 col-lg-4">
            <label for="postcode" class="form-label">Postcode *</label>
            <input type="text" class="form-control" id="postcode" required />
        </div>
        
        
        
    </div>
</form>

<div class="mt-4 mb-4 p-2 bg-light border rounded shadow-sm text-start">
    <p class="fs-5 fw-bold text-dark mb-0">
      You are about to pay <span class="text-success fs-4">@Model.TotalAmount.ToString("C")</span>
    </p>
</div>

<!-- Pay Button -->
<button id="payButton" class="btn custom-checkout-btn">Pay Now</button>

<!-- Styling -->
<style>
    .custom-checkout-btn {
        background-color: #136f3c;
        color: white;
        padding: 12px 30px;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .custom-checkout-btn:hover {
            background-color: #0f5d31;
            transform: scale(1.05);
            box-shadow: 5px 5px 12px rgba(0, 0, 0, 0.3);
        }
</style>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        document.getElementById("payButton").addEventListener("click", async () => {
          const resp = await fetch('/api/payments/create-checkout-session', {
            method: 'POST',
            credentials: 'include'
          });
          const data = await resp.json();

          if (resp.ok) {
            const stripe = Stripe("@Model.PublishableKey");
            await stripe.redirectToCheckout({ sessionId: data.sessionId });
          } else {
            alert(data.error || "Could not start Stripe checkout.");
          }
        });
    </script>
}
