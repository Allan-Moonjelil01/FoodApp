@model Models.MenuTypeViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Menu Type" : "New Menu Type";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Meals</label>
        <div>
            @foreach (var meal in Model.AvailableMeals)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedMealIds"
                           value="@meal.Value"
                           id="meal_@meal.Value"
                    @(Model.SelectedMealIds.Contains(int.Parse(meal.Value)) ? "checked" : "") />
                    <label class="form-check-label" for="meal_@meal.Value">
                        @meal.Text
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="SelectedMealIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        @(isEdit ? "Save" : "Create")
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
