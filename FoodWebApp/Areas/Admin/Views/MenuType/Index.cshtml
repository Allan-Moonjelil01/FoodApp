@model IEnumerable<MealType>
@{
    ViewData["Title"] = "Menu Types";
}
<h2>@ViewData["Title"]</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">Add New Type</a>
</p>
<table class="table">
    <thead><tr><th>Name</th><th>Meals</th><th /></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@string.Join(", ", t.Meals.Select(m => m.Name))</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
