@model DataAccess.MenuItem
@{
  var isEdit = Model.Id != 0;
  ViewData["Title"] = isEdit ? "Edit Item" : "Add Item";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="@(isEdit ? "Edit" : "CreateItem")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label>Available</label>
        <div class="form-check">
            <input asp-for="Available"
                   class="form-check-input"
                   type="radio"
                   value="Yes"
                   id="AvailableYes" />
            <label class="form-check-label" for="AvailableYes">Yes</label>
        </div>
        <div class="form-check">
            <input asp-for="Available"
                   class="form-check-input"
                   type="radio"
                   value="No"
                   id="AvailableNo" />
            <label class="form-check-label" for="AvailableNo">No</label>
        </div>
        <span asp-validation-for="Available" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        @(isEdit ? "Save Changes" : "Add Item")
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
