@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <!-- Carousel & Welcome Text -->
    <div class="row shadow rounded">
        <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">
            <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner h-100">
                    <div class="carousel-item active">
                        <img src="/images/carouselImages/pexels-fotios-photos-1279330.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>
                    <div class="carousel-item">
                        <img src="/images/carouselImages/magic-foods.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>
                    <div class="carousel-item">
                        <img src="/images/carouselImages/pexels-ash-craig-122861-376464.jpg" class="d-block w-100 h-110" alt="Recipes">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">
            <div class="mb-3">
                <h2><span class="text-success"><strong>Get the Best Food from the Finest Restaurant</strong></span></h2>
            </div>
            <div class="mb-3 p-3"><i class="fa-solid fa-leaf text-success mx-2 fs-4"></i><span class="fs-5 text-dark">Fresh Food</span></div>
            <div class="mb-3 p-3"><i class="fa-solid fa-leaf text-success mx-2 fs-4"></i><span class="fs-5 text-dark">Fast Delivery</span></div>
            <div class="mb-3 p-3"><i class="fa-solid fa-leaf text-success mx-2 fs-4"></i><span class="fs-5 text-dark">Best Quality</span></div>
        </div>
    </div>

    <!-- Today's Special -->
    <div class="row mt-5">
        <div class="col-12 mb-3">
            <h2 class="text-bg-dark p-2">Today's Special</h2>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow emboss-card">
                <img src="http://forkify-api.herokuapp.com/images/steakhousepizza0b87.jpg" class="card-img-top rounded-top" style="height:250px; object-fit:cover;" alt="Pizza">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Pizza</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow emboss-card">
                <img src="http://forkify-api.herokuapp.com/images/Bacon2BDouble2BCheese2BBurger2BSalad2B5002B61668d04f9e9.jpg" class="card-img-top rounded-top" style="height:250px; object-fit:cover;" alt="Burger">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Burger</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow emboss-card">
                <img src="http://forkify-api.herokuapp.com/images/4204711663_3b0de36aaecd31.jpg" class="card-img-top rounded-top" style="height:250px; object-fit:cover;" alt="Macaroni">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Macaroni</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Meet The Team Section -->
    <section class="py-5 bg-white text-center">
        <div class="container">
            <h2 class="fw-bold mb-5">Meet The Team</h2>
            <div class="row justify-content-center">
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow">
                        <img src="/images/team/AdobeStock_233189785_Preview.jpeg" class="card-img-top rounded-top" alt="Joshua Was">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Joshua Was</h5>
                            <p class="card-text text-success">Chef/Owner</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow">
                        <img src="/images/team/AdobeStock_403117871_Preview.jpeg" class="card-img-top rounded-top" alt="Yishni jaco">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Yishni jaco</h5>
                            <p class="card-text text-success">Chef/Co-Owner</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow">
                        <img src="/images/team/AdobeStock_223003725_Preview.jpeg" class="card-img-top rounded-top" alt="Revisha Karuna">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Revisha Karuna</h5>
                            <p class="card-text text-success">Front of House</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow">
                        <img src="/images/team/AdobeStock_641882588_Preview.jpeg" class="card-img-top rounded-top" alt="Gimesha resh">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Gimesha resh</h5>
                            <p class="card-text text-success">Pastry Chef</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
