@{
    Layout = null;
    ViewData["Title"] = "Welcome";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Food WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center align-items-center" style="height:100vh;">
    <div class="text-center">
        <h1 class="mb-4">Food WebApp</h1>
        <div class="d-grid gap-3 col-6 mx-auto">
            <a class="btn btn-lg btn-outline-primary" asp-area="Admin" asp-controller="Menu" asp-action="Index">Admin</a>
            <a class="btn btn-lg btn-outline-success" asp-area="Customer" asp-controller="Home" asp-action="Index">Customer</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
